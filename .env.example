# Environment Variables Template
# Copy to .env and fill in real values

# GitHub API token (for GitHub Open Source Radar Search API)
GITHUB_TOKEN=

# MiniMax Token Plan API key (for Phase 3A+ asset generation)
# Get from: MiniMax Console > Token Plan Management > Token Plan Key
# Format: sk-cp-...
# Token Plan Key is different from pay-per-use API key
MINIMAX_API_KEY=sk-cp-your-token-plan-key-here

# Telegram bot token (for Phase 3B+ reports)
TELEGRAM_BOT_TOKEN=

# Tavily API Key (for web search in research pipeline)
TAVILY_API_KEY=
