# Sandbox runtime outputs (local only, never commit)
reports/sandbox/daily-digest/*
!reports/sandbox/daily-digest/.gitkeep
!reports/sandbox/README.md

# Local control auth config (never commit real token)
.control.local

# Audit logs (never commit runtime audit data)
reports/control-action-audit.jsonl

# Dependencies
node_modules/

# Environment (never commit secrets)
.env
.env.local
.env.production
.env.telegram.local
.env.telegram.*
# Exception: .env.example is a template and is safe to commit
!.env.example
!.env.telegram.example

# Local config (per-machine customization, never commit)
config/*.local.json
# Exception: .example.json is a template and is safe to commit
!config/*.example.json
# Local budget override
config/source-budgets.json
# Exception: keep the example template
!config/source-budgets.example.json

# SQLite signal database
data/*.db
data/*.sqlite
data/*.sqlite3

# Logs and temp files
logs/
tmp/
*.log
*.tmp
*.temp

# macOS
.DS_Store
*.DS_Store

# Build artifacts
dist/
build/
*.js.map

# TypeScript incremental (optional)
tsconfig.tsbuildinfo

# Coverage
coverage/
.nyc_output/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~